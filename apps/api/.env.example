# Neon Postgres connection string (get from the Vercel Postgres / Neon dashboard)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Secret used to sign JWTs — any long random string
JWT_SECRET=replace-with-a-long-random-string

# Gemini API key (https://aistudio.google.com/apikey), used server-side only for request
# classification/routing. If unset, the app falls back to the user-picked type + a default
# department instead of failing.
GEMINI_API_KEY=

# Model used for classification (cheap/fast model is enough for this task)
GEMINI_MODEL=gemini-flash-latest

# Shared secret checked on the /api/cron/sla-check route (Vercel Cron sends this header)
CRON_SECRET=replace-with-a-long-random-string
